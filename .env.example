# ==============================================================================
# Environment Configuration Example
# Copy this file to .env.local for local development.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database -> Connection string:
#
# 1. Connection Pooling (Transaction Mode - Recommended for Serverless/Next.js):
#    Port: 6543, Parameter: ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Session Pooling (Direct Mode - Used for Migrations):
#    Port: 5432
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Details
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# ------------------------------------------------------------------------------
# Email Delivery Configuration (List Collaboration Invitations)
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER selects the delivery strategy:
# - "console": (Default for local development) Prints invitation links and details to stdout/terminal logs.
# - "resend":  (Production) Dispatches transactional emails via Resend HTTP API.
EMAIL_PROVIDER=console

# Required only if EMAIL_PROVIDER is set to "resend". Do NOT commit real API keys to version control.
RESEND_API_KEY=

# Sender address for transactional emails (e.g., "invites@yourdomain.com"). Must be verified in Resend.
EMAIL_FROM=

